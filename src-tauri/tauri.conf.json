{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life",
  "version": "0.2.7",
  "identifier": "app.life.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Life",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NjlBMUUyNzMzQTAyQgpSV1Fyb0RNbkhwcG1BbHAyQmhKUTVqUk84d3BJNC9NSkpCdVpPWUgzWFl1dWNXMktNQmJkYTNaeAo=",
      "endpoints": [
        "https://github.com/GuilhermeGuerhardt/MyLife/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Guilherme",
    "category": "Productivity",
    "shortDescription": "Dashboard da vida",
    "longDescription": "Saúde, alimentação, faculdade, cursos, finanças e rotina em um lugar só.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
