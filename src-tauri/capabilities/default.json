{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "O que a interface do Life pode pedir ao processo nativo.",
  "windows": [
    "main",
    "janela-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "notification:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "updater:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize"
  ]
}
